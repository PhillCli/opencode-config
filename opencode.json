{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "instructions": [
    "AGENTS.md"
  ],
  "model": "opencode-go/gpt-5.6-luna",
//"plugin": ["opencode-openmemory"],
  "small_model": "opencode-go/gpt-5.6-luna",
  "agents": {
    "plan": {
      "model": "opencode-go/glm-5.2#max"
    },
    "build": {
      "model": "opencode-go/glm-5.2#max"
    },
    "codebase-explorer": {
      "model": "opencode-go/gpt-5.6-luna#low"
    },
    "debugger": {
      "model": "opencode-go/gpt-5.6-luna#medium"
    },
    "documenter": {
      "model": "opencode-go/gpt-5.6-luna#low"
    },
    "implementer": {
      "model": "opencode-go/gpt-5.6-luna#low"
    },
    "researcher": {
      "model": "opencode-go/gpt-5.6-luna#high"
    },
    "reviewer": {
      "model": "opencode-go/gpt-5.6-luna#medium"
    },
    "tester": {
      "model": "opencode-go/gpt-5.6-luna#medium"
    }
  },
  "formatter": {
    "terraform": {
      "disabled": false,
      "command": [
        "terraform",
        "fmt",
        "$FILE"
      ],
      "extensions": [
        ".tf",
        ".hcl",
        ".tfvars"
      ]
    },
    "shfmt": {
      "disabled": false,
      "command": [
        "shfmt",
        "-w",
        "$FILE"
      ],
      "extensions": [
        ".sh",
        ".bash",
        ".zsh",
        ".ksh"
      ]
    },
    "prettier": {
      "disabled": false,
      "command": [
        "mise",
        "x",
        "npm:prettier",
        "--",
        "prettier",
        "--write",
        "--tab-width",
        "2",
        "$FILE"
      ],
      "extensions": [
        ".json"
      ]
    }
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "disabled": false
      }
    }
  },

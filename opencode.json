// Project config when the workspace is this repo. Also keep ~/.config/opencode/opencode.json in sync — that file is what other projects load. No secrets (use {env:VAR}).
{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "model": "xai/grok-4.7",
  "small_model": "opencode-go/gpt-5.6-luna",
  "default_agent": "build",
  "formatter": {
    "terraform": {
      "disabled": false,
      "command": ["terraform", "fmt", "$FILE"],
      "extensions": [".tf", ".hcl", ".tfvars"]
    },
    "shfmt": {
      "disabled": false,
      "command": ["shfmt", "-w", "$FILE"],
      "extensions": [".sh", ".bash", ".zsh", ".ksh"]
    },
    "prettier": {
      "disabled": false,
      "command": [
        "mise",
        "x",
        "npm:prettier",
        "--",
        "prettier",
        "--write",
        "--tab-width",
        "2",
        "$FILE"
      ],
      "extensions": [".json"]
    }
  },
  "mcp": {
    "servers": {
      "terraform-mcp-server": {
        "type": "local",
        "command": ["terraform-mcp-server"],
        "disabled": true
      },
      "flux-operator-mcp-server": {
        "type": "local",
        "command": ["flux-operator-mcp", "serve"],
        "environment": {
          "KUBECONFIG": "/home/filip/.kube/config"
        },
        "disabled": true
      },
      "context7-mcp-server": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@upstash/context7-mcp",
          "--api-key",
          "{env:CONTEXT7_API_KEY}"
        ],
        "disabled": false
      }
    }
  },
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "*id_rsa*", "effect": "deny" },
    { "action": "read", "resource": "*id_ed25519*", "effect": "deny" },
    { "action": "read", "resource": "*credentials.json*", "effect": "deny" },
    { "action": "read", "resource": "*terraform.tfstate*", "effect": "deny" },
    { "action": "read", "resource": "*secrets.yaml*", "effect": "deny" },
    { "action": "read", "resource": "*secrets.yml*", "effect": "deny" },
    { "action": "read", "resource": "*.tfvars", "effect": "deny" },
    { "action": "read", "resource": "~/.aws/*", "effect": "deny" },
    { "action": "read", "resource": "*/.aws/*", "effect": "deny" },
    { "action": "read", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "read", "resource": "*/.ssh/*", "effect": "deny" },
    { "action": "read", "resource": "~/.kube/*", "effect": "deny" },
    { "action": "read", "resource": "*/.kube/*", "effect": "deny" },
    { "action": "read", "resource": "~/.gnupg/*", "effect": "deny" },
    { "action": "read", "resource": "*/.gnupg/*", "effect": "deny" },
    { "action": "read", "resource": "~/.netrc", "effect": "deny" },
    { "action": "read", "resource": "*/.netrc", "effect": "deny" },

    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },
    { "action": "edit", "resource": "*.pem", "effect": "deny" },
    { "action": "edit", "resource": "*.key", "effect": "deny" },
    { "action": "edit", "resource": "*id_rsa*", "effect": "deny" },
    { "action": "edit", "resource": "*id_ed25519*", "effect": "deny" },
    { "action": "edit", "resource": "*credentials.json*", "effect": "deny" },
    { "action": "edit", "resource": "*terraform.tfstate*", "effect": "deny" },
    { "action": "edit", "resource": "*secrets.yaml*", "effect": "deny" },
    { "action": "edit", "resource": "*secrets.yml*", "effect": "deny" },
    { "action": "edit", "resource": "*.tfvars", "effect": "deny" },
    { "action": "edit", "resource": "~/.aws/*", "effect": "deny" },
    { "action": "edit", "resource": "*/.aws/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "edit", "resource": "*/.ssh/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.kube/*", "effect": "deny" },
    { "action": "edit", "resource": "*/.kube/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.gnupg/*", "effect": "deny" },
    { "action": "edit", "resource": "*/.gnupg/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.netrc", "effect": "deny" },
    { "action": "edit", "resource": "*/.netrc", "effect": "deny" },

    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "allow" },

    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "/tmp*", "effect": "allow" },
    {
      "action": "external_directory",
      "resource": "~/.config/opencode/skills/*",
      "effect": "allow"
    },

    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git add *", "effect": "allow" },
    { "action": "shell", "resource": "git stage *", "effect": "allow" },
    { "action": "shell", "resource": "git commit *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout *", "effect": "ask" },
    { "action": "shell", "resource": "git switch *", "effect": "ask" },
    { "action": "shell", "resource": "git merge *", "effect": "ask" },
    { "action": "shell", "resource": "git rebase *", "effect": "ask" },
    { "action": "shell", "resource": "git reset *", "effect": "ask" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },
    { "action": "shell", "resource": "git stash *", "effect": "ask" },
    { "action": "shell", "resource": "git tag *", "effect": "ask" },
    { "action": "shell", "resource": "git restore *", "effect": "ask" },
    { "action": "shell", "resource": "git branch -d*", "effect": "ask" },
    { "action": "shell", "resource": "git branch -D*", "effect": "ask" },
    { "action": "shell", "resource": "git cherry-pick *", "effect": "ask" },
    { "action": "shell", "resource": "git revert *", "effect": "ask" },
    { "action": "shell", "resource": "git* push*--force*", "effect": "deny" },
    { "action": "shell", "resource": "git* push* -f*", "effect": "deny" },
    { "action": "shell", "resource": "git* reset*--hard*", "effect": "deny" },
    { "action": "shell", "resource": "git config*", "effect": "deny" },

    { "action": "shell", "resource": "sudo*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf /*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf /", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf ~*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf $HOME*", "effect": "deny" },
    { "action": "shell", "resource": "curl *| sh*", "effect": "deny" },
    { "action": "shell", "resource": "curl *| bash*", "effect": "deny" },
    { "action": "shell", "resource": "wget *| sh*", "effect": "deny" },
    { "action": "shell", "resource": "wget *| bash*", "effect": "deny" },
    { "action": "shell", "resource": "*169.254.169.254*", "effect": "deny" },
    {
      "action": "shell",
      "resource": "*metadata.google.internal*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*metadata.azure.internal*",
      "effect": "deny"
    },
    { "action": "shell", "resource": "*~/.ssh*", "effect": "deny" },
    { "action": "shell", "resource": "*/.ssh/*", "effect": "deny" },
    { "action": "shell", "resource": "*~/.aws*", "effect": "deny" },
    { "action": "shell", "resource": "*/.aws/*", "effect": "deny" },
    { "action": "shell", "resource": "*~/.gnupg*", "effect": "deny" },
    { "action": "shell", "resource": "*/.gnupg/*", "effect": "deny" },
    { "action": "shell", "resource": "*~/.kube*", "effect": "deny" },
    { "action": "shell", "resource": "*/.kube/*", "effect": "deny" },
    { "action": "shell", "resource": "*~/.netrc*", "effect": "deny" },
    { "action": "shell", "resource": "*/.netrc*", "effect": "deny" },
    { "action": "shell", "resource": "*.env", "effect": "deny" },
    { "action": "shell", "resource": "*.env *", "effect": "deny" },
    { "action": "shell", "resource": "*.env.*", "effect": "deny" },
    { "action": "shell", "resource": "*.env.example*", "effect": "allow" },
    { "action": "shell", "resource": "env", "effect": "deny" },
    { "action": "shell", "resource": "env *", "effect": "deny" },
    { "action": "shell", "resource": "*/env", "effect": "deny" },
    { "action": "shell", "resource": "*/env *", "effect": "deny" },
    { "action": "shell", "resource": "printenv*", "effect": "deny" },
    { "action": "shell", "resource": "*/printenv*", "effect": "deny" },
    { "action": "shell", "resource": "*.tfvars*", "effect": "deny" },
    { "action": "shell", "resource": "cat /proc/*/environ*", "effect": "deny" },

    { "action": "shell", "resource": "terraform* apply*", "effect": "ask" },
    { "action": "shell", "resource": "terraform* destroy*", "effect": "deny" },
    { "action": "shell", "resource": "terraform* state*", "effect": "deny" },
    { "action": "shell", "resource": "terraform* show*", "effect": "deny" },
    { "action": "shell", "resource": "terraform* output*", "effect": "deny" },
    { "action": "shell", "resource": "tofu* apply*", "effect": "ask" },
    { "action": "shell", "resource": "tofu* destroy*", "effect": "deny" },
    { "action": "shell", "resource": "tofu* state*", "effect": "deny" },
    { "action": "shell", "resource": "tofu* show*", "effect": "deny" },
    { "action": "shell", "resource": "tofu* output*", "effect": "deny" },
    { "action": "shell", "resource": "terragrunt* apply*", "effect": "ask" },
    { "action": "shell", "resource": "terragrunt* destroy*", "effect": "deny" },
    { "action": "shell", "resource": "terragrunt* state*", "effect": "deny" },
    { "action": "shell", "resource": "terragrunt* show*", "effect": "deny" },
    { "action": "shell", "resource": "terragrunt* output*", "effect": "deny" },
    { "action": "shell", "resource": "kubectl* apply*", "effect": "ask" },
    { "action": "shell", "resource": "kubectl* delete*", "effect": "deny" },
    { "action": "shell", "resource": "kubectl* exec*", "effect": "deny" },
    {
      "action": "shell",
      "resource": "kubectl* get* secret*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "kubectl* describe* secret*",
      "effect": "deny"
    },
    { "action": "shell", "resource": "helm* install*", "effect": "ask" },
    { "action": "shell", "resource": "helm* upgrade*", "effect": "ask" },
    { "action": "shell", "resource": "helm* delete*", "effect": "deny" },
    { "action": "shell", "resource": "helm* uninstall*", "effect": "deny" },

    { "action": "shell", "resource": "npm install*", "effect": "ask" },
    { "action": "shell", "resource": "pip install*", "effect": "ask" },
    {
      "action": "shell",
